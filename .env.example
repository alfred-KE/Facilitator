# ─── Aventure Studio — Shared Dev Environment ───
# Copier ce fichier vers ../../.env (racine du workspace Aventurestudio/)
# et remplir les valeurs.

# Vercel (obtenir via: vercel tokens create)
VERCEL_TOKEN=
VERCEL_TEAM=

# GoDaddy API (https://developer.godaddy.com/keys)
GODADDY_API_KEY=
GODADDY_API_SECRET=
